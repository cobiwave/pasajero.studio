'use client';

import type { FC } from 'react'
import type { ControllerProps } from './Page{{titleCase name}}.controller'

import { useMemo } from 'react'
import classNames from 'classnames'
import { animate } from 'motion'

import { copy } from '@/utils/copy'

import { useRefs } from '@/hooks/use-refs'
import { useTransitionPresence } from '@/hooks/use-transition-presence'

import css from './Page{{titleCase name}}.module.scss'

export interface ViewProps extends ControllerProps {}

export type ViewRefs = {
root: HTMLElement
}

export const View: FC<ViewProps> = ({ content }) => {
  const refs = useRefs<ViewRefs>()

    useTransitionPresence(
    useMemo(
    () => ({
    animateIn: () => animate(refs.root.current!, { opacity: 1 }, { delay: 0.15 }),
    animateOut: () => animate(refs.root.current!, { opacity: 0 })
    }),
    [refs]
    )
    )

    return (
    <main className={classNames('Page{{titleCase name}}', css.root)} ref={refs.root}>
      <h1 className={css.title} {...copy.html(content.body.title)} />
    </main>
    )
    }

    View.displayName = 'Page{{titleCase name}}_View'