import type { StoryFn } from '@storybook/react'
import type { ViewProps } from './Page{{titleCase name}}.view'

import { CmsService } from '@/services/cms.service'

import { TransitionPresence } from '@/motion/transition.presence'

import { View } from './Page{{titleCase name}}.view'

export default { title: 'pages/Page{{titleCase name}}' }

export const Default: StoryFn<ViewProps & { show: boolean }> = ({ show, ...args }) => {
  return (
    <TransitionPresence>
      {show ? <View {...args} content={CmsService.getPageContent('{{camelCase name}}')} /> : null}
    </TransitionPresence>
  )
}

Default.args = {
  show: true
}

Default.argTypes = {}
