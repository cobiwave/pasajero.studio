import type { BaseButtonProps } from '@/components/BaseButton'
import type { SvgId } from '#/svg-imports'

import { forwardRef, memo } from 'react'

import { View } from './{{titleCase name}}.view'

export interface ControllerProps extends Omit<BaseButtonProps, 'children'> {
  className?: string
  label: string
  icon?: SvgId
  iconClass?: string
}

export const Controller = memo(
  forwardRef<HTMLElement, ControllerProps>((props, ref) => {
    return <View {...props} ref={ref} />
  })
)

Controller.displayName = '{{titleCase name}}_Controller'
